// The real server, hand-written in the language.
model "efraingaray.com server" "Extracted from the running machine" {

  spec {
    node host "Physical or virtual machine"
    node container "Running container" {
      requires technology
    }
    node service "Process managed by systemd"
    node domain "Name exposed to the Internet"
    node decision "Architecture decision" {
      requires status
    }
    relation routes {
      from domain
    }
    relation affects "Ties a decision to what it decides" {
      from decision
    }
  }

  vps = host "Hostinger VPS" "Ubuntu 24.04 · 4 cores · 15 GB" {
    caddy = container "infra-caddy-1" {
      technology "caddy"
      tags "running, exposed"
    }
    likes_svc = service "likes" {
      port "8813"
    }
  }

  web = domain "efraingaray.com"

  adr001 = decision "Tie firewall rules to each service" {
    status "accepted"
    date "2026-08-19"
    doc "Context" """On reboot the iptables rules were lost and two services returned 502. Each rule is now tied to the startup of its own systemd unit."""
  }

  web -routes-> caddy "HTTPS"
  adr001 -affects-> likes_svc "The rule lives in this unit"

  view everything "The whole server" {
    include *
  }
  view decisions "Which decisions touch the likes service" {
    include neighbors likes_svc 1
  }
}
